# Project Root Environment Template (Refer to server/.env.example and client/.env.example)

# Backend (Server)
PORT=5000
NODE_ENV=production
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/ranjit_travels
JWT_SECRET=your_jwt_secret_key
CLIENT_URL=https://ranjit-tour-travels.vercel.app

# Admin Credentials (Set securely in host environment variables)
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@ranjittravels.com
ADMIN_PASSWORD=your_secure_admin_password
ADMIN_PHONE=+919816596713

# Frontend (Client)
VITE_API_URL=https://ranjit-tour-travels-api.onrender.com/api
VITE_API_ORIGIN=https://ranjit-tour-travels-api.onrender.com
